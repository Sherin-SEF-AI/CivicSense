# Copy to .env.local and fill in.

# Enables the understanding tier: scene assessment, context assessment, legal
# selection and the pre-dispatch policy audit. Get a key from console.groq.com.
# Without it incidents still form and severity is still computed; only the
# written assessment is absent, and the console says so.
GROQ_API_KEY=

# Where the console talks to. Defaults to this application's own API.
NEXT_PUBLIC_API_BASE=/api/v1

# Storage locations. Defaults sit under ./data.
# CIVICSENSE_DB=data/civicsense.db
# CIVICSENSE_EVIDENCE=data/evidence

# Named on the bootstrapped administrator account.
# CIVICSENSE_ADMIN_NAME=administrator
# CIVICSENSE_ADMIN_EMAIL=admin@localhost
