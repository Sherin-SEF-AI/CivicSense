{
  "name": "civicsense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run sync:map && next dev -p 3111",
    "build": "npm run sync:map && next build",
    "start": "next start -p 3111",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "glyphs": "tsx scripts/gen-glyph-sprite.ts",
    "audit:design": "tsx scripts/audit-design.ts",
    "sync:map": "node scripts/sync-map-worker.mjs",
    "e2e": "rm -rf .e2e && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run audit:design && npm run e2e",
    "osm": "node --max-old-space-size=8192 scripts/extract-osm.mjs",
    "bootstrap": "tsx --conditions react-server scripts/bootstrap.ts",
    "check:groq": "tsx --conditions react-server --env-file-if-exists=.env.local scripts/check-groq.ts",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12.11.1",
    "h3-js": "4.5.0",
    "hls.js": "1.7.1",
    "maplibre-gl": "6.6.0",
    "next": "15.5.24",
    "osm-pbf-parser": "^2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "uplot": "1.6.32",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
